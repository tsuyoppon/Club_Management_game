DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/club_game
API_PREFIX=/api
WEB_SESSION_COOKIE=club_game_session
WEB_SESSION_TTL_DAYS=14
# Set true behind HTTPS when the browser reaches the app over a secure origin.
WEB_COOKIE_SECURE=false
COMPOSE_PROJECT_NAME=club_management_game
# Resolve the currently mounted volume before setting this value. Never guess it.
CLUB_GAME_PGDATA_VOLUME=club_management_game_pgdata
# Local operator default. Backups remain outside the repository and Docker volume.
CLUB_GAME_BACKUP_DIR=/Users/scide_furusawa/.club-management-game/backups
