<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.club-management-game.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>/Users/scide_furusawa/Documents/Club_Management_game/scripts/backup_manager.py</string>
    <string>db</string>
    <string>create</string>
    <string>--reason</string>
    <string>scheduled</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/scide_furusawa/Documents/Club_Management_game</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>CLUB_GAME_BACKUP_DIR</key>
    <string>/Users/scide_furusawa/.club-management-game/backups</string>
    <key>CLUB_GAME_PGDATA_VOLUME</key>
    <string>club_management_game_pgdata</string>
    <key>COMPOSE_PROJECT_NAME</key>
    <string>club_management_game</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/scide_furusawa/.club-management-game/backups/status/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/scide_furusawa/.club-management-game/backups/status/launchd.stderr.log</string>
</dict>
</plist>
